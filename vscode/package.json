{
  "name": "threatmodeller",
  "displayName": "Craig's Threat Modeller",
  "description": "Reads the threat modelling languages in an editor, through the threatmodeller language server.",
  "version": "0.0.0",
  "publisher": "craigjbass",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/craigjbass/threat-modeller.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:threatmodeller-architecture",
    "onLanguage:threatmodeller-controls",
    "onLanguage:threatmodeller-library",
    "onLanguage:threatmodeller-attacktree",
    "onLanguage:threatmodeller-governance",
    "onLanguage:threatmodeller-policy"
  ],
  "contributes": {
    "languages": [
      {
        "id": "threatmodeller-architecture",
        "aliases": [
          "Threat Modeller Architecture"
        ],
        "extensions": [
          ".arch"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "threatmodeller-controls",
        "aliases": [
          "Threat Modeller Controls"
        ],
        "extensions": [
          ".controls"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "threatmodeller-library",
        "aliases": [
          "Threat Modeller Library"
        ],
        "extensions": [
          ".lib"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "threatmodeller-attacktree",
        "aliases": [
          "Threat Modeller Attack Tree"
        ],
        "extensions": [
          ".attacktree"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "threatmodeller-governance",
        "aliases": [
          "Threat Modeller Governance"
        ],
        "extensions": [
          ".governance"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "threatmodeller-policy",
        "aliases": [
          "Threat Modeller Policy"
        ],
        "filenames": [
          "policy.hcl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Craig's Threat Modeller",
      "properties": {
        "threatmodeller.path": {
          "type": "string",
          "default": "threatmodeller",
          "markdownDescription": "The path of the `threatmodeller` executable. The default reads the name from `PATH`."
        }
      }
    },
    "commands": [
      {
        "command": "threatmodeller.check",
        "title": "Check",
        "category": "Threat Modeller"
      },
      {
        "command": "threatmodeller.compile",
        "title": "Compile",
        "category": "Threat Modeller"
      },
      {
        "command": "threatmodeller.draw",
        "title": "Draw",
        "category": "Threat Modeller"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "glob": "^11.0.0",
    "mocha": "^12.0.1",
    "typescript": "^5.7.2"
  }
}
